@"
# Byte-compiled / Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# C extensions / compiled modules
*.pyd

# Temporary & Log files generated by scripts
*.log
planner_desktop_import_log.csv
planner_sync_preview.csv

# Excel / Data input/output files
*.xlsx
*.xls
*.csv
*.json

# IDE & Editor settings
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db
"@ | Out-File -Encoding utf8 .gitignore