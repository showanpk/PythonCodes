# Option A: paste a full Azure SQL ODBC connection string here.
# Never commit the real .env file to GitHub.
SQL_CONNECTION_STRING=

# Option B: let the script build the connection string.
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database

# Choose: interactive | password
SQL_AUTH=interactive

# Only required when SQL_AUTH=password
SQL_USERNAME=
SQL_PASSWORD=

# Optional: custom ODBC driver
ODBC_DRIVER=ODBC Driver 18 for SQL Server
